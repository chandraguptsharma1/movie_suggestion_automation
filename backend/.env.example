# TMDB API
TMDB_BEARER_TOKEN=your_tmdb_bearer_token_here
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_REGION=IN

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Sarvam AI TTS
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_MODEL=bulbul:v4-flash
SARVAM_SPEAKER=vipul_hi_social

# Database (Leave blank to use zero-config local SQLite: storage/movie_suggestion.db)
DATABASE_URL=

# Media Storage
STORAGE_DIR=storage
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Server Port
PORT=8000
HOST=0.0.0.0
# Optional YouTube OAuth configuration. Keep this directory outside STORAGE_DIR.
# YOUTUBE_PRIVATE_DIR=D:/movie_suggestion_automation/backend/.youtube_private
# YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8001/api/youtube/oauth/callback
